# GigaChat API Configuration
# Получите API ключ на https://developers.sber.ru/portal/products/gigachat
GIGACHAT_API_KEY=your_gigachat_api_key_here

# Yandex Cloud AI Configuration
# Получите API ключ и Folder ID на https://yandex.cloud/ru/docs/ai-studio/
YANDEX_CLOUD_API_KEY=your_yandex_cloud_api_key_here
YANDEX_CLOUD_FOLDER_ID=your_yandex_cloud_folder_id_here

# OpenRouter Configuration
# Получите API ключ на https://openrouter.ai/
# Доступ к множеству моделей через единый API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development
