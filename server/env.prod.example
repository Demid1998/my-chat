# Production Environment Configuration
# Скопируйте этот файл в .env.prod и заполните реальными значениями

# GigaChat API Configuration
# Получите API ключ на https://developers.sber.ru/portal/products/gigachat
GIGACHAT_API_KEY=your_production_gigachat_api_key_here

# Yandex Cloud AI Configuration
# Получите API ключ и Folder ID на https://yandex.cloud/ru/docs/ai-studio/
YANDEX_CLOUD_API_KEY=your_production_yandex_cloud_api_key_here
YANDEX_CLOUD_FOLDER_ID=your_production_yandex_cloud_folder_id_here

# OpenRouter Configuration
# Получите API ключ на https://openrouter.ai/
# Доступ к множеству моделей через единый API
OPENROUTER_API_KEY=your_production_openrouter_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=production

# Security (опционально)
# SECRET_KEY=your_secret_key_for_jwt_or_sessions
# CORS_ORIGIN=https://yourdomain.com
